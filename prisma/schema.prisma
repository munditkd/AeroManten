generator client {
  provider      = "prisma-client-js"
  // "native" = motor para tu maquina de desarrollo (Windows). Se agrega
  // "rhel-openssl-3.0.x" porque el hosting de produccion (AlmaLinux, familia
  // RHEL, con OpenSSL 3.0) bloquea/tiene problemas para descargar motores en
  // caliente desde binaries.prisma.sh, asi que hace falta pre-descargarlo
  // desde una maquina con internet sin restricciones y subirlo a mano al
  // servidor. Prisma no detecta bien "AlmaLinux" (cae a "debian" por
  // defecto), pero el target correcto para esta familia de distros es
  // rhel-openssl-3.0.x, no debian-openssl-3.0.x.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  passwordHash  String
  // "role" sigue siendo el super-usuario del sistema (ADMIN = acceso total,
  // sin importar el grupo). "grupoId" define los permisos de
  // insertar/modificar/borrar para todos los demás usuarios.
  role          Role      @default(USER)
  grupoId       String?
  // Persona de la tabla Personal que corresponde a esta cuenta de login (si
  // ya se vinculó). Se usa para completar solo el "originador" de las OT.
  personalId    String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Requerido por el adapter de Auth.js si en el futuro sumás
  // login social (Google, GitHub, etc.)
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  grupo               Grupo?               @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  personal            Personal?            @relation(fields: [personalId], references: [id], onDelete: SetNull)

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Propietario {
  id        String   @id @default(cuid())
  nombre    String
  documento String?
  telefono  String?
  email     String?
  direccion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aeronaves Aeronave[]

  @@map("propietarios")
}

model Aeronave {
  id               String    @id @default(cuid())
  // Contador interno para generar "codigo" (AN-001 en adelante). Todavia no
  // se usa para nada (las relaciones siguen por matricula), solo prolija
  // la base para uso futuro.
  secuencia        Int       @unique @default(autoincrement())
  codigo           String    @unique
  matricula        String    @unique
  marca            String?
  modelo           String?
  numeroSerie      String?
  fechaFabricacion DateTime?
  // TSN = Time Since New (desde fabricación) · TSO = Time Since Overhaul (desde la última revisión)
  horasTSN         Float?
  horasTSO         Float?
  ciclosTSN        Int?
  ciclosTSO        Int?
  mesesTSN         Int?
  mesesTSO         Int?
  propietarioId    String
  // Null = todavía sin clasificar. Se completa a mano por ahora.
  estadoId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  propietario               Propietario                     @relation(fields: [propietarioId], references: [id], onDelete: Cascade)
  estado                    Estado?                         @relation(fields: [estadoId], references: [id])
  activos                   Activo[]
  mantenimientos            RegistroMantenimiento[]
  mantenimientosPreventivos ActivoMantenimientoPreventivo[]
  ordenesTrabajo            OrdenTrabajo[]

  @@map("aeronaves")
}

model Activo {
  id               String    @id @default(cuid())
  codigo           Int       @unique @default(autoincrement())
  tipo             String
  marca            String?
  modelo           String?
  numeroSerie      String?
  fechaFabricacion DateTime?
  horasTSN         Float?
  horasTSO         Float?
  ciclosTSN        Int?
  ciclosTSO        Int?
  mesesTSN         Int?
  mesesTSO         Int?
  // Null = en depósito / como repuesto, sin montar en ninguna aeronave.
  aeronaveId       String?
  // Null = todavía sin clasificar. Se completa a mano por ahora.
  estadoId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  aeronave                  Aeronave?                       @relation(fields: [aeronaveId], references: [id], onDelete: SetNull)
  estado                    Estado?                         @relation(fields: [estadoId], references: [id])
  mantenimientos            RegistroMantenimiento[]
  mantenimientosPreventivos ActivoMantenimientoPreventivo[]
  ordenesTrabajo            OrdenTrabajo[]

  @@map("activos")
}

model RegistroMantenimiento {
  id          String   @id @default(cuid())
  descripcion String   @db.Text
  fecha       DateTime
  aeronaveId  String
  activoId    String?
  createdAt   DateTime @default(now())

  aeronave Aeronave @relation(fields: [aeronaveId], references: [id], onDelete: Cascade)
  activo   Activo?  @relation(fields: [activoId], references: [id], onDelete: Cascade)

  @@map("registros_mantenimiento")
}

model MantenimientoPreventivo {
  id          String   @id @default(cuid())
  codigo      String   @unique
  descripcion String
  horas       Float?
  ciclos      Int?
  meses       Int?
  tarea       String   @db.Text
  personas    Int?
  horasHombre Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activos        ActivoMantenimientoPreventivo[]
  ordenesTrabajo OrdenTrabajo[]

  @@map("mantenimientos_preventivos")
}

// Vincula un MP con lo que le aplica: un activo específico (ej. un motor)
// O una aeronave completa (ej. una Recorrida General). Siempre se carga
// exactamente uno de los dos (activoId o aeronaveId), nunca ambos ni ninguno.
model ActivoMantenimientoPreventivo {
  id                        String   @id @default(cuid())
  activoId                  String?
  aeronaveId                String?
  mantenimientoPreventivoId String
  createdAt                 DateTime @default(now())

  activo                  Activo?                            @relation(fields: [activoId], references: [id], onDelete: Cascade)
  aeronave                Aeronave?                          @relation(fields: [aeronaveId], references: [id], onDelete: Cascade)
  mantenimientoPreventivo MantenimientoPreventivo            @relation(fields: [mantenimientoPreventivoId], references: [id], onDelete: Cascade)
  realizaciones           MantenimientoPreventivoRealizado[]

  @@unique([activoId, mantenimientoPreventivoId])
  @@unique([aeronaveId, mantenimientoPreventivoId])
  @@map("activos_mantenimientos_preventivos")
}

// Historial de cada vez que se realizó el MP sobre ese activo.
// El vencimiento se calcula a partir de la realización más reciente.
model MantenimientoPreventivoRealizado {
  id            String   @id @default(cuid())
  relacionId    String
  fecha         DateTime
  horas         Float?
  ciclos        Int?
  observaciones String?  @db.Text
  createdAt     DateTime @default(now())

  relacion ActivoMantenimientoPreventivo @relation(fields: [relacionId], references: [id], onDelete: Cascade)

  @@map("mantenimientos_preventivos_realizados")
}

enum RolPersonal {
  PILOTO
  MECANICO
  OPERARIO
  ADMINISTRATIVO
}

model Personal {
  id                           String      @id @default(cuid())
  nombre                       String
  apellido                     String
  dni                          String?     @unique
  telefono                     String?
  email                        String?
  fechaNacimiento              DateTime?
  legajo                       String?     @unique
  rol                          RolPersonal
  habilitado                   Boolean     @default(false)
  fechaInicioHabilitacion      DateTime?
  fechaVencimientoHabilitacion DateTime?
  grupoId                      String?
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  grupo                     Grupo?                   @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  ordenesTrabajoOriginadas  OrdenTrabajo[]           @relation("OTOriginador")
  ordenesTrabajoResponsable OrdenTrabajo[]           @relation("OTResponsable")
  manoDeObra                OrdenTrabajoManoDeObra[]
  user                      User?

  @@map("personal")
}

// Los checkboxes (insertar/modificar/borrar/noUsar) son flags propios del
// grupo por ahora; más adelante van a definir permisos por entidad, no solo
// a nivel de grupo entero.
model Grupo {
  id            String   @id @default(cuid())
  codigo        String   @unique
  descripcion   String
  insertar      Boolean  @default(false)
  modificar     Boolean  @default(false)
  borrar        Boolean  @default(false)
  noUsar        Boolean  @default(false)
  observaciones String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  personal Personal[]
  usuarios User[]

  @@map("grupos")
}

// Tabla auxiliar genérica de estados, reusable por cualquier entidad. "tabla"
// + "propiedad" identifican a qué campo de qué entidad aplica cada fila
// (ej. tabla="OrdenTrabajo", propiedad="estado"), "status" es la etiqueta
// visible, y "rstatus" es la categoría fija de la que depende la lógica del
// sistema sin importar cómo se llame o traduzca "status" (para OT:
// ABIERTA/CERRADA; para Activo/Aeronave: OPERATIVO/NO_OPERATIVO/BAJA).
// "noUsar" saca una fila de las listas desplegables sin borrar el historial
// que ya la usa.
model Estado {
  id        String   @id @default(cuid())
  tabla     String
  propiedad String
  status    String
  rstatus   String
  noUsar    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordenesTrabajo OrdenTrabajo[]
  activos        Activo[]
  aeronaves      Aeronave[]

  @@unique([tabla, propiedad, status])
  @@map("estados")
}

enum PrioridadOT {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model OrdenTrabajo {
  id           String   @id @default(cuid())
  // Contador interno para generar "codigo" (ej. OT-00001) solo, sin
  // depender del valor que se haya tipeado a mano en OT viejas.
  secuencia    Int      @unique @default(autoincrement())
  codigo       String   @unique
  descripcion  String   @db.Text
  // tipo/clase/categoria quedan como texto libre por ahora; se pueden
  // convertir en listas fijas más adelante cuando haya valores definidos.
  tipo         String?
  clase        String?
  categoria    String?
  fecha        DateTime
  estadoId     String
  departamento String?

  // Null = OT no ligada a una aeronave/activo puntual (ej. tarea de taller).
  aeronaveId String?
  activoId   String?

  // Plan de mantenimiento preventivo del que surge esta OT (si aplica).
  mantenimientoPreventivoId String?

  fechaInicio         DateTime?
  fechaFinPlanificado DateTime?
  duracionEstimada    Float?
  duracionReal        Float?

  originadorId  String?
  responsableId String?
  prioridad     PrioridadOT @default(MEDIA)
  falla         String?     @db.Text
  fechaCerrado  DateTime?
  costo         Float?
  hsTotales     Float?

  // Se completa solo, con el usuario logueado que hizo el último guardado.
  actualizadoPor String?
  comentarios    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  estado                  Estado                   @relation(fields: [estadoId], references: [id])
  aeronave                Aeronave?                @relation(fields: [aeronaveId], references: [id], onDelete: SetNull)
  activo                  Activo?                  @relation(fields: [activoId], references: [id], onDelete: SetNull)
  mantenimientoPreventivo MantenimientoPreventivo? @relation(fields: [mantenimientoPreventivoId], references: [id], onDelete: SetNull)
  originador              Personal?                @relation("OTOriginador", fields: [originadorId], references: [id], onDelete: SetNull)
  responsable             Personal?                @relation("OTResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  manoDeObra              OrdenTrabajoManoDeObra[]

  @@map("ordenes_trabajo")
}

// Carga de mano de obra: varias entradas por OT (una por operario/día/tarea).
model OrdenTrabajoManoDeObra {
  id              String    @id @default(cuid())
  ordenTrabajoId  String
  personalId      String?
  fecha           DateTime?
  horasTrabajadas Float?
  tareas          String?   @db.Text
  costo           Float?
  comentarios     String?   @db.Text
  createdAt       DateTime  @default(now())

  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  personal     Personal?    @relation(fields: [personalId], references: [id], onDelete: SetNull)

  @@map("ordenes_trabajo_mano_obra")
}
