# Conexión a tu base MySQL/MariaDB
# Formato: mysql://usuario:password@host:puerto/nombre_db
DATABASE_URL="mysql://usuario:password@localhost:3306/mi_app"

# Genera este valor con: openssl rand -base64 32
AUTH_SECRET="reemplazar-con-un-secreto-largo-y-random"

# URL base de tu app (en desarrollo local)
NEXTAUTH_URL="http://localhost:3000"

# --- Envío de emails: verificación de cuenta, recuperación de contraseña, y
# Requerimientos a Proveedores (Mail Comercial del Propietario como remitente
# ahí) — todo vía la API HTTP de Brevo (https://brevo.com), no SMTP directo.
# Conseguí la API key en Brevo → Settings → SMTP & API → API Keys.
# El remitente de cada mail tiene que estar verificado en Brevo (Senders).
BREVO_API_KEY="xkeysib-reemplazar-con-tu-api-key"
# OJO: sin comillas internas escapadas. El nombre va tal cual, seguido del
# email entre < >. Poner comillas (EMAIL_FROM="\"Mi App\" <...>") rompe el
# parseo del remitente y Brevo rechaza el envío ("valid sender email required").
EMAIL_FROM="Mi App <no-reply@miapp.com>"
